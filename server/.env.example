# ---- Runtime ----
NODE_ENV=development
PORT=4000

# ---- Postgres (local Docker) ----
DATABASE_URL=postgresql://aurore:aurore@localhost:5432/aurore
DIRECT_URL=postgresql://aurore:aurore@localhost:5432/aurore
# Test database (used by Jest integration tests)
TEST_DATABASE_URL=postgresql://aurore:aurore@localhost:5433/aurore_test
# Neon (production) - pooled for runtime, direct for migrations:
# DATABASE_URL=postgresql://<user>:<password>@<endpoint>-pooler.<region>.aws.neon.tech/<db>?sslmode=require&pgbouncer=true&connection_limit=5
# DIRECT_URL=postgresql://<user>:<password>@<endpoint>.<region>.aws.neon.tech/<db>?sslmode=require

# ---- Redis (local Docker) ----
REDIS_URL=redis://localhost:6379
# Upstash (production) - TLS URL:
# REDIS_URL=rediss://default:<password>@<host>.upstash.io:6379
RATE_LIMIT_STORE=memory

# ---- Auth ----
JWT_ACCESS_SECRET=change-me-access
JWT_REFRESH_SECRET=change-me-refresh
CLIENT_URL=http://localhost:5173
CORS_ORIGINS=http://localhost:5173
COOKIE_SAMESITE=lax

# ---- Google OAuth ----
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_CALLBACK_URL=http://localhost:4000/api/v1/auth/google/callback

# ---- External APIs ----
NASA_API_KEY=DEMO_KEY
LL2_BASE_URL=https://ll.thespacedevs.com/2.2.0

# ---- Cloudinary ----
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# ---- SMTP ----
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
MAIL_FROM=Aurore <no-reply@aurore.local>
